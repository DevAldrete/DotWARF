# ── App ───────────────────────────────────────────────────────────────────────
DEBUG=false

# A strong random string – used to guard the /api/v1/leads admin endpoint
ADMIN_API_KEY=change-me-in-production

# ── Database ─────────────────────────────────────────────────────────────────
# For local dev without Docker: adjust host/port as needed
DATABASE_URL=postgresql+asyncpg://dotwarf:dotwarf@localhost:5432/dotwarf

# ── AI / LiteLLM ─────────────────────────────────────────────────────────────
# Model string understood by LiteLLM (e.g. openai/gpt-4o-mini, anthropic/claude-3-haiku-20240307)
LITELLM_MODEL=openai/gpt-4o-mini
OPENAI_API_KEY=sk-...

# ── Rate limits (slowapi format: "N/period") ──────────────────────────────────
CHAT_RATE_LIMIT=20/hour
CONTACT_RATE_LIMIT=5/hour

# ── SMTP (Gmail) ─────────────────────────────────────────────────────────────
# Use a Gmail App Password (not your regular password):
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=you@gmail.com
CONTACT_RECIPIENT_EMAIL=you@gmail.com

# ── CORS ─────────────────────────────────────────────────────────────────────
# JSON list of allowed origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
